:root {
  --bg-primary: #EAEAEA;
  --bg-secondary: #DFDFDF;
  --bg-card: #F4F4F4;
  --bg-elevated: #FAFAFA;
  --bg-glass: rgba(234, 234, 234, 0.86);

  --text-primary: #141414;
  --text-secondary: #484848;
  --text-muted: #767676;

  --accent-orange: #D9532F;
  --accent-olive: #566352;

  --border-subtle: rgba(20, 20, 20, 0.16);
  --border-strong: #141414;

  --font-display: 'Syne', sans-serif;
  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  --fs-xs: clamp(0.72rem, 0.7rem + 0.12vw, 0.78rem);
  --fs-sm: clamp(0.875rem, 0.84rem + 0.16vw, 0.9375rem);
  --fs-base: clamp(0.95rem, 0.92rem + 0.18vw, 1.02rem);
  --fs-h3: clamp(1.2rem, 1.1rem + 0.45vw, 1.45rem);
  --fs-h2: clamp(1.9rem, 1.5rem + 1.9vw, 3.05rem);
  --fs-h1: clamp(2.15rem, 1.55rem + 3.2vw, 4.45rem);

  --container-max: 1400px;
  --gutter: clamp(1rem, 3vw, 2.5rem);
  --header-height: 76px;
  --radius-none: 0px;
  --radius-sm: 2px;

  --ease-editorial: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);

  --shadow-card: 10px 10px 0px rgba(20, 20, 20, 0.08);
  --shadow-modal: 0 30px 70px -15px rgba(20, 20, 20, 0.28);
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: auto;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--fs-base);
  font-weight: 400;
  line-height: 1.55;
  overflow-x: hidden;
  position: relative;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.032;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

button {
  background: none;
  border: none;
  cursor: pointer;
}

ul {
  list-style: none;
}

:focus-visible {
  outline: 1.5px solid var(--text-primary);
  outline-offset: 3px;
}

.container {
  width: 100%;
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

.eyebrow {
  display: block;
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 0.65rem;
}

.section-title {
  font-family: var(--font-display);
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  color: var(--text-primary);
}

.serif-accent {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 500;
  text-transform: lowercase;
  letter-spacing: 0;
  font-size: 1.16em;
  display: inline-block;
}

.frame-tag {
  display: inline-flex;
  align-items: center;
  padding: 0.42rem 0.9rem;
  border: 1.5px solid var(--border-strong);
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.frame-tag--italic {
  background-color: var(--bg-elevated);
  color: var(--text-primary);
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.92rem;
  letter-spacing: 0.02em;
  text-transform: none;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.92rem 1.75rem;
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: var(--radius-none);
  transition: background-color 0.35s var(--ease-editorial),
              color 0.35s var(--ease-editorial),
              border-color 0.35s var(--ease-editorial),
              transform 0.25s var(--ease-editorial);
  will-change: transform;
}

.btn--primary {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  border: 1.5px solid var(--text-primary);
}

.btn--primary:hover {
  background-color: var(--accent-orange);
  border-color: var(--accent-orange);
}

.btn--ghost {
  background-color: var(--bg-elevated);
  color: var(--text-primary);
  border: 1.5px solid var(--border-strong);
}

.btn--ghost:hover {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
}

.btn--full {
  width: 100%;
}

.preloader {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background-color: var(--bg-primary);
  display: grid;
  place-items: center;
  pointer-events: all;
}

.preloader__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  padding-inline: 1.5rem;
  text-align: center;
}

.preloader__svg {
  width: 78px;
  height: 78px;
}

.preloader__brand {
  font-family: var(--font-display);
  font-size: clamp(1rem, 2vw, 1.45rem);
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--text-primary);
}

.preloader__line {
  width: 140px;
  height: 2px;
  background-color: var(--text-primary);
  transform-origin: left center;
  transform: scaleX(0);
}

.header {
  position: sticky;
  top: 0;
  z-index: 900;
  height: var(--header-height);
  background-color: var(--bg-glass);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1.5px solid var(--border-strong);
}

.header__inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 0.85rem;
  flex-shrink: 0;
  will-change: transform, opacity;
}

.logo__svg {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  color: var(--text-primary);
  transition: transform 0.5s var(--ease-editorial);
}

.logo:hover .logo__svg {
  transform: rotate(-4deg) scale(1.04);
}

.logo__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
}

.logo__text {
  font-family: var(--font-display);
  font-size: clamp(0.84rem, 1vw, 0.98rem);
  font-weight: 700;
  letter-spacing: 0.06em;
}

.logo__sub {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--text-secondary);
}

.nav {
  display: none;
  will-change: transform, opacity;
}

@media (min-width: 1080px) {
  .nav {
    display: block;
    background-color: var(--bg-elevated);
    border: 1.5px solid var(--border-strong);
    padding: 0.45rem 1.35rem;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }

  .nav__link {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color 0.25s ease;
  }

  .nav__link:hover {
    color: var(--text-primary);
  }
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
  will-change: transform, opacity;
}

.cart-trigger {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.5rem 1rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.cart-trigger:hover {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
}

.cart-trigger__count {
  min-width: 22px;
  height: 22px;
  padding-inline: 6px;
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  font-size: 0.7rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.cart-trigger:hover .cart-trigger__count {
  background-color: var(--accent-orange);
}

.mobile-menu-btn {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  width: 38px;
  height: 38px;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
}

.mobile-menu-btn span {
  display: block;
  width: 18px;
  height: 1.5px;
  background-color: var(--text-primary);
  margin-inline: auto;
  transition: transform 0.3s var(--ease-editorial);
}

.mobile-menu-btn[aria-expanded="true"] span:first-child {
  transform: translateY(3.75px) rotate(45deg);
}

.mobile-menu-btn[aria-expanded="true"] span:last-child {
  transform: translateY(-3.75px) rotate(-45deg);
}

@media (min-width: 1080px) {
  .mobile-menu-btn {
    display: none;
  }
}

.mobile-nav {
  position: fixed;
  inset: var(--header-height) 0 0 0;
  z-index: 890;
  background-color: var(--bg-primary);
  padding: 2.5rem var(--gutter);
  transform: translateY(-100%);
  opacity: 0;
  visibility: hidden;
  transition: transform 0.45s var(--ease-editorial), opacity 0.35s ease, visibility 0.35s;
}

.mobile-nav.is-open {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
}

.mobile-nav__list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.mobile-nav__link {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-primary);
}

.hero {
  padding-block: clamp(2rem, 4.5vw, 3.75rem) clamp(3.5rem, 6vw, 5.5rem);
  border-bottom: 1.5px solid var(--border-strong);
  overflow: hidden;
}

.hero__top-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin-bottom: 1.5rem;
}

.hero__title {
  font-family: var(--font-display);
  font-size: var(--fs-h1);
  font-weight: 800;
  line-height: 0.96;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
}

.hero__line {
  display: block;
  will-change: transform, opacity;
}

.hero__bento {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}

@media (min-width: 960px) {
  .hero__bento {
    grid-template-columns: 1.3fr 1fr 0.9fr;
    align-items: stretch;
  }
}

.bento-card {
  position: relative;
  overflow: hidden;
  border: 1.5px solid var(--border-strong);
  background-color: var(--bg-card);
  will-change: transform, opacity;
}

.bento-card--left,
.bento-card--right {
  min-height: 320px;
}

@media (min-width: 960px) {
  .bento-card--left,
  .bento-card--right {
    min-height: 430px;
  }
}

.bento-card img {
  width: 100%;
  height: 112%;
  object-fit: cover;
  will-change: transform;
}

.bento-card__label {
  position: absolute;
  bottom: 0.9rem;
  left: 0.9rem;
  padding: 0.4rem 0.85rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.bento-card--center {
  padding: clamp(1.5rem, 2.5vw, 2.25rem);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.75rem;
  background-color: var(--bg-elevated);
}

.bento-card__monogram {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-subtle);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.bento-card__monogram svg {
  width: 28px;
  height: 28px;
}

.bento-card__lead {
  font-size: var(--fs-base);
  color: var(--text-secondary);
  line-height: 1.65;
}

.hero__cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.image-reveal {
  clip-path: inset(0 0 0 0);
}

.shop-section {
  padding-block: clamp(4rem, 7vw, 6.5rem);
  overflow: hidden;
}

.section-header {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: clamp(2rem, 4vw, 3.25rem);
}

@media (min-width: 900px) {
  .section-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
  }
}

.split-header__left,
.split-header__right {
  will-change: transform, opacity;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  padding: 0.35rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
}

.filter-btn {
  padding: 0.55rem 1.05rem;
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-secondary);
  transition: all 0.3s var(--ease-editorial);
}

.filter-btn:hover {
  color: var(--text-primary);
}

.filter-btn.is-active {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
}

.products-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 640px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1080px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.product-card {
  display: flex;
  flex-direction: column;
  background-color: var(--bg-card);
  border: 1.5px solid var(--border-strong);
  overflow: hidden;
  transition: box-shadow 0.45s var(--ease-editorial);
  transform-style: preserve-3d;
  will-change: transform, opacity;
}

.product-card:hover {
  box-shadow: var(--shadow-card);
}

.product-card__media {
  position: relative;
  aspect-ratio: 4 / 4.6;
  background-color: var(--bg-secondary);
  overflow: hidden;
  cursor: pointer;
  border-bottom: 1.5px solid var(--border-strong);
}

.product-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.65s var(--ease-editorial), transform 0.85s var(--ease-editorial);
}

.product-card__img--detail {
  opacity: 0;
  transform: scale(1.04);
}

.product-card:hover .product-card__img--primary {
  opacity: 0;
  transform: scale(1.03);
}

.product-card:hover .product-card__img--detail {
  opacity: 1;
  transform: scale(1);
}

.product-card__badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  z-index: 2;
  padding: 0.35rem 0.75rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.product-card__qv-btn {
  position: absolute;
  bottom: 0.75rem;
  right: 0.75rem;
  z-index: 2;
  padding: 0.48rem 0.95rem;
  background-color: var(--bg-elevated);
  color: var(--text-primary);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1.5px solid var(--border-strong);
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.35s var(--ease-editorial), transform 0.35s var(--ease-editorial), background-color 0.25s ease, color 0.25s ease;
}

.product-card:hover .product-card__qv-btn,
.product-card__qv-btn:focus-visible {
  opacity: 1;
  transform: translateY(0);
}

.product-card__qv-btn:hover {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
}

@media (hover: none) {
  .product-card__qv-btn {
    opacity: 0.95;
    transform: translateY(0);
  }
}

.product-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.25rem;
}

.product-card__paper {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--accent-olive);
  font-weight: 600;
  margin-bottom: 0.3rem;
}

.product-card__title {
  font-family: var(--font-sans);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -0.015em;
  line-height: 1.28;
  margin-bottom: 1rem;
}

.product-card__variant-label {
  display: block;
  font-size: 0.68rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.4rem;
}

.product-card__select {
  width: 100%;
  padding: 0.65rem 0.9rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-subtle);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 1.15rem;
  cursor: pointer;
  transition: border-color 0.25s ease;
}

.product-card__select:hover,
.product-card__select:focus {
  border-color: var(--border-strong);
}

.product-card__footer {
  margin-top: auto;
  padding-top: 0.95rem;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.product-card__price {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
}

.product-card__add-btn {
  padding: 0.62rem 1.15rem;
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: background-color 0.3s ease;
}

.product-card__add-btn:hover {
  background-color: var(--accent-orange);
}

.craft-section {
  padding-block: clamp(4rem, 7vw, 6.5rem);
  background-color: var(--bg-secondary);
  border-block: 1.5px solid var(--border-strong);
  overflow: hidden;
}

.craft__header-note {
  max-width: 44ch;
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

.craft__bento {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}

@media (min-width: 640px) {
  .craft__bento {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1080px) {
  .craft__bento {
    grid-template-columns: repeat(4, 1fr);
  }
}

.craft-card {
  background-color: var(--bg-elevated);
  padding: 1.75rem;
  border: 1.5px solid var(--border-strong);
  display: flex;
  flex-direction: column;
  will-change: transform, opacity;
}

.craft-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.craft-card__num {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-primary);
}

.craft-card__tag {
  padding: 0.25rem 0.65rem;
  border: 1.5px solid var(--border-strong);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.craft-card__title {
  font-family: var(--font-sans);
  font-size: var(--fs-h3);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 0.75rem;
}

.craft-card__text {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

.craft-card__meta {
  margin-top: auto;
  padding-top: 0.85rem;
  border-top: 1px solid var(--border-subtle);
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--accent-olive);
}

.custom-section {
  padding-block: clamp(4rem, 7vw, 6.5rem);
  overflow: hidden;
}

.custom__wrapper {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(2rem, 4.5vw, 4rem);
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  padding: clamp(1.5rem, 4vw, 3.5rem);
}

@media (min-width: 960px) {
  .custom__wrapper {
    grid-template-columns: 0.95fr 1.05fr;
  }
}

.custom__info,
.custom-form {
  will-change: transform, opacity;
}

.custom__desc {
  color: var(--text-secondary);
  margin-top: 1.15rem;
  margin-bottom: 1.65rem;
}

.custom__perks {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.custom__perks li {
  position: relative;
  padding-left: 1.35rem;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--text-primary);
}

.custom__perks li::before {
  content: "→";
  position: absolute;
  left: 0;
  color: var(--accent-orange);
  font-weight: 700;
}

.custom-form {
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.15rem;
}

@media (min-width: 640px) {
  .form-row {
    grid-template-columns: 1fr 1fr;
  }
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-label {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.form-input,
.form-select,
.form-textarea {
  width: 100%;
  padding: 0.85rem 1rem;
  background-color: var(--bg-primary);
  border: 1.5px solid var(--border-subtle);
  font-size: var(--fs-sm);
  transition: border-color 0.25s ease;
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  outline: none;
  border-color: var(--border-strong);
}

.form-feedback {
  font-size: var(--fs-sm);
  min-height: 1.4em;
  color: var(--accent-olive);
  font-weight: 600;
}

.form-feedback.is-error {
  color: var(--accent-orange);
}

.footer {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  padding-top: clamp(3.5rem, 6vw, 4.75rem);
  padding-bottom: 2rem;
}

.footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  padding-bottom: 2.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
}

@media (min-width: 840px) {
  .footer__grid {
    grid-template-columns: 1.5fr 1fr 1fr;
  }
}

.footer__logo-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.footer__logo-row .logo__svg {
  color: var(--bg-elevated);
}

.footer__tagline {
  margin-top: 0.95rem;
  max-width: 38ch;
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, 0.68);
}

.footer__heading {
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 0.95rem;
}

.footer__links {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, 0.85);
}

.footer__links a:hover {
  color: var(--accent-orange);
}

.footer__bottom {
  padding-top: 1.65rem;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 1rem;
  font-size: var(--fs-xs);
  color: rgba(255, 255, 255, 0.5);
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1100;
  display: grid;
  place-items: center;
  padding: 1rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s var(--ease-editorial), visibility 0.35s;
}

.modal.is-open {
  opacity: 1;
  visibility: visible;
}

.modal__backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(20, 20, 20, 0.65);
  backdrop-filter: blur(6px);
}

.modal__container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 940px;
  max-height: 90vh;
  overflow-y: auto;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  box-shadow: var(--shadow-modal);
  transform: translateY(18px) scale(0.98);
  transition: transform 0.4s var(--ease-editorial);
}

.modal.is-open .modal__container {
  transform: translateY(0) scale(1);
}

.modal__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 10;
  width: 38px;
  height: 38px;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  font-size: 1.4rem;
  line-height: 1;
  display: grid;
  place-items: center;
  transition: background-color 0.25s ease, color 0.25s ease;
}

.modal__close:hover {
  background-color: var(--text-primary);
  color: var(--bg-elevated);
}

.qv-grid {
  display: grid;
  grid-template-columns: 1fr;
}

@media (min-width: 768px) {
  .qv-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.qv-zoom-box {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background-color: var(--bg-secondary);
  cursor: zoom-in;
  border-bottom: 1.5px solid var(--border-strong);
}

.qv-zoom-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.2s ease-out;
  transform-origin: center center;
}

.qv-zoom-hint {
  position: absolute;
  bottom: 0.85rem;
  left: 0.85rem;
  padding: 0.35rem 0.8rem;
  background-color: var(--bg-elevated);
  border: 1.5px solid var(--border-strong);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  pointer-events: none;
}

.qv-thumbs {
  display: flex;
  gap: 0.65rem;
  padding: 0.85rem 1.5rem;
  background-color: var(--bg-secondary);
}

.qv-thumb {
  width: 56px;
  height: 70px;
  border: 1.5px solid transparent;
  overflow: hidden;
  opacity: 0.6;
  transition: opacity 0.25s ease, border-color 0.25s ease;
}

.qv-thumb.is-active {
  opacity: 1;
  border-color: var(--border-strong);
}

.qv-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.qv-details {
  padding: clamp(1.5rem, 3vw, 2.5rem);
  display: flex;
  flex-direction: column;
}

.qv-title {
  font-family: var(--font-sans);
  font-size: clamp(1.45rem, 2.2vw, 1.85rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.18;
  margin-bottom: 0.6rem;
}

.qv-price {
  font-family: var(--font-display);
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--accent-orange);
  margin-bottom: 1.15rem;
}

.qv-desc {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: 1.35rem;
}

.qv-spec {
  padding: 0.85rem 1rem;
  background-color: var(--bg-primary);
  border: 1px solid var(--border-subtle);
  font-size: var(--fs-xs);
  margin-bottom: 1.35rem;
}

.cart-drawer {
  position: fixed;
  inset: 0;
  z-index: 1200;
  visibility: hidden;
  pointer-events: none;
}

.cart-drawer.is-open {
  visibility: visible;
  pointer-events: auto;
}

.cart-drawer__backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(20, 20, 20, 0.55);
  backdrop-filter: blur(4px);
  opacity: 0;
  transition: opacity 0.4s var(--ease-editorial);
}

.cart-drawer.is-open .cart-drawer__backdrop {
  opacity: 1;
}

.cart-drawer__panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 450px;
  background-color: var(--bg-elevated);
  border-left: 1.5px solid var(--border-strong);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.5s var(--ease-editorial);
}

.cart-drawer.is-open .cart-drawer__panel {
  transform: translateX(0);
}

.cart-drawer__header {
  padding: 1.35rem 1.75rem;
  border-bottom: 1.5px solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-drawer__title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.cart-drawer__close {
  font-size: 1.75rem;
  line-height: 1;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
}

.cart-drawer__body {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.cart-empty {
  margin-block: auto;
  text-align: center;
  color: var(--text-secondary);
  padding-block: 3rem;
}

.cart-item {
  display: grid;
  grid-template-columns: 74px 1fr;
  gap: 1rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--border-subtle);
}

.cart-item__img {
  width: 74px;
  height: 92px;
  object-fit: cover;
  border: 1px solid var(--border-strong);
  background-color: var(--bg-secondary);
}

.cart-item__info {
  display: flex;
  flex-direction: column;
}

.cart-item__title {
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.25;
}

.cart-item__variant {
  font-size: 0.78rem;
  color: var(--text-secondary);
  margin-top: 0.2rem;
}

.cart-item__controls {
  margin-top: auto;
  padding-top: 0.65rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-stepper {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--border-strong);
  background-color: var(--bg-primary);
}

.qty-stepper button {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  font-size: 0.95rem;
}

.qty-stepper span {
  min-width: 26px;
  text-align: center;
  font-size: 0.85rem;
  font-weight: 600;
}

.cart-item__price {
  font-weight: 700;
  font-size: var(--fs-sm);
}

.cart-item__remove {
  font-size: 0.72rem;
  color: var(--text-muted);
  text-decoration: underline;
  margin-left: 0.75rem;
}

.cart-item__remove:hover {
  color: var(--accent-orange);
}

.cart-drawer__footer {
  padding: 1.5rem 1.75rem;
  background-color: var(--bg-secondary);
  border-top: 1.5px solid var(--border-strong);
}

.cart-summary-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-sm);
  color: var(--text-secondary);
  margin-bottom: 0.5rem;
}

.cart-summary-row--total {
  margin-top: 0.85rem;
  padding-top: 0.85rem;
  border-top: 1.5px solid var(--border-strong);
  font-size: var(--fs-base);
  font-weight: 700;
  color: var(--text-primary);
}

.cart-free-shipping-note {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent-olive);
  margin-block: 0.85rem 1.15rem;
}

.toast {
  position: fixed;
  bottom: 1.75rem;
  left: 50%;
  z-index: 1500;
  transform: translate(-50%, 120%);
  padding: 0.85rem 1.5rem;
  background-color: var(--text-primary);
  color: var(--bg-elevated);
  border: 1.5px solid var(--bg-elevated);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.06em;
  box-shadow: var(--shadow-modal);
  opacity: 0;
  transition: transform 0.4s var(--ease-editorial), opacity 0.35s ease;
  pointer-events: none;
}

.toast.is-visible {
  transform: translate(-50%, 0);
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .preloader {
    display: none;
  }
}