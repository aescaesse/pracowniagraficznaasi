/* =================================================================at
   DESIGN SYSTEM & ZMIENNE CSS
   ========================================================================== */
:root {
  --bg-color: #FAF8F5;
  --bg-card: #F3EFEA;
  --bg-card-hover: #ECE6DE;
  --text-main: #1C1B1A;
  --text-muted: #6B6864;
  --text-light: #9E9A94;
  --accent: #9A7B56;          /* Ciepłe, matowe złoto / brąz */
  --accent-hover: #7E6343;
  --sage: #7A8B79;            /* Akcent szałwiowy */
  --terracotta: #B86B51;      /* Akcent terakoty */
  --border-color: #E2DDD5;
  --border-dark: #1C1B1A;
  
  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans: 'Plus Jakarta Sans', sans-serif;
  
  --header-height: 80px;
  --container-max: 1320px;
  --radius-sm: 4px;
  --radius-md: 12px;
  --radius-lg: 20px;
  
  --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
  --shadow-subtle: 0 10px 30px -10px rgba(28, 27, 26, 0.05);
  --shadow-hover: 0 20px 40px -15px rgba(28, 27, 26, 0.12);
}

/* ==========================================================================
   RESET & BAZA
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Integracja z Lenis Smooth Scroll */
html.lenis, html.lenis body {
  height: auto;
}
.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}
.lenis.lenis-smooth [data-lenis-prevent] {
  overscroll-behavior: contain;
}
.lenis.lenis-stopped {
  overflow: hidden;
}
.lenis.lenis-scrolling iframe {
  pointer-events: none;
}

body {
  overflow-x: hidden;
  line-height: 1.6;
}

::selection {
  background-color: var(--accent);
  color: #fff;
}

ul {
  list-style: none;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
  border: none;
  background: none;
}

button {
  cursor: pointer;
}

.container {
  width: 100%;
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 2rem;
}

.section-padding {
  padding: 8rem 0;
}

@media (max-width: 768px) {
  .section-padding {
    padding: 5rem 0;
  }
  .container {
    padding: 0 1.25rem;
  }
}

/* Płynna typografia */
.eyebrow {
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 1rem;
  display: block;
}

h1, h2, h3, .brand__title {
  font-family: var(--font-serif);
  font-weight: 500;
  line-height: 1.15;
}

/* ==========================================================================
   PRELOADER
   ========================================================================== */
.preloader {
  position: fixed;
  inset: 0;
  background-color: var(--bg-color);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.8s var(--transition-smooth), visibility 0.8s;
}

.preloader.is-loaded {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.preloader__inner {
  text-align: center;
}

.preloader__monogram {
  font-family: var(--font-serif);
  font-size: 3rem;
  font-weight: 400;
  letter-spacing: 0.2em;
  margin-bottom: 0.5rem;
  display: block;
  color: var(--text-main);
}

.preloader__text {
  font-size: 0.875rem;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  margin-bottom: 2rem;
  text-transform: uppercase;
}

.preloader__line {
  width: 180px;
  height: 2px;
  background-color: var(--border-color);
  margin: 0 auto;
  overflow: hidden;
  position: relative;
}

.preloader__progress {
  position: absolute;
  inset: 0;
  background-color: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.6s var(--transition-smooth);
}

/* ==========================================================================
   HEADER & NAWIGACJA (Glassmorphism)
   ========================================================================== */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--header-height);
  z-index: 1000;
  display: flex;
  align-items: center;
  background-color: rgba(250, 248, 245, 0.8);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(226, 221, 213, 0.5);
  transition: transform 0.4s var(--transition-smooth), background-color 0.4s;
}

.header__container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.brand {
  display: flex;
  flex-direction: column;
}

.brand__title {
  font-size: 1.35rem;
  letter-spacing: -0.01em;
  color: var(--text-main);
}

.brand__subtitle {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-muted);
}

.nav__list {
  display: flex;
  gap: 2.5rem;
}

.nav__link {
  font-size: 0.925rem;
  font-weight: 500;
  color: var(--text-main);
  position: relative;
  transition: color 0.3s;
}

.nav__link::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 1px;
  background-color: var(--text-main);
  transition: width 0.3s var(--transition-smooth);
}

.nav__link:hover::after {
  width: 100%;
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.cart-trigger {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 1.25rem;
  background-color: var(--text-main);
  color: var(--bg-color);
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background-color 0.3s, transform 0.2s;
}

.cart-trigger:hover {
  background-color: var(--accent);
}

.cart-trigger__badge {
  background-color: var(--bg-color);
  color: var(--text-main);
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 600;
}

.mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 6px;
  width: 32px;
  height: 32px;
  justify-content: center;
  align-items: center;
}

.mobile-toggle span {
  width: 24px;
  height: 2px;
  background-color: var(--text-main);
  transition: transform 0.3s;
}

@media (max-width: 992px) {
  .nav {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: 100%;
    height: calc(100vh - var(--header-height));
    background-color: var(--bg-color);
    padding: 3rem 2rem;
    transform: translateX(100%);
    transition: transform 0.5s var(--transition-smooth);
    border-top: 1px solid var(--border-color);
  }
  .nav.is-open {
    transform: translateX(0);
  }
  .nav__list {
    flex-direction: column;
    gap: 2rem;
  }
  .nav__link {
    font-size: 1.5rem;
    font-family: var(--font-serif);
  }
  .mobile-toggle {
    display: flex;
  }
}

/* ==========================================================================
   SEKCJA HERO
   ========================================================================== */
.hero {
  padding-top: calc(var(--header-height) + 4rem);
  padding-bottom: 6rem;
  min-height: 90vh;
  display: flex;
  align-items: center;
}

.hero__grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 4rem;
  align-items: center;
}

.hero__title {
  font-size: clamp(2.75rem, 5vw, 4.5rem);
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
  color: var(--text-main);
}

.hero__title em {
  font-style: italic;
  font-weight: 400;
  color: var(--accent);
}

.hero__description {
  font-size: 1.125rem;
  color: var(--text-muted);
  max-width: 540px;
  margin-bottom: 2.5rem;
}

.hero__cta-group {
  display: flex;
  gap: 1.25rem;
  align-items: center;
  margin-bottom: 3.5rem;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  border-radius: 50px;
  font-size: 0.925rem;
  font-weight: 500;
  transition: all 0.3s var(--transition-smooth);
}

.btn--primary {
  background-color: var(--text-main);
  color: var(--bg-color);
}

.btn--primary:hover {
  background-color: var(--accent);
  transform: translateY(-2px);
}

.btn--ghost {
  border: 1px solid var(--border-dark);
  color: var(--text-main);
}

.btn--ghost:hover {
  background-color: var(--text-main);
  color: var(--bg-color);
}

.hero__meta {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-color);
}

.hero__meta-item strong {
  display: block;
  font-size: 1.125rem;
  font-family: var(--font-serif);
  color: var(--text-main);
}

.hero__meta-item span {
  font-size: 0.8rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.hero__meta-divider {
  width: 1px;
  height: 32px;
  background-color: var(--border-color);
}

.hero__visuals {
  position: relative;
  height: 560px;
}

.reveal-mask {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-subtle);
}

.reveal-mask img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s var(--transition-smooth);
}

.reveal-mask:hover img {
  transform: scale(1.04);
}

.hero__image-main {
  width: 85%;
  height: 480px;
}

.hero__image-floating {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 55%;
  height: 280px;
  border: 6px solid var(--bg-color);
}

.hero__caption {
  position: absolute;
  bottom: 12px;
  left: 12px;
  background-color: rgba(28, 27, 26, 0.85);
  color: #fff;
  padding: 0.4rem 0.8rem;
  font-size: 0.75rem;
  border-radius: var(--radius-sm);
  backdrop-filter: blur(4px);
}

@media (max-width: 992px) {
  .hero__grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .hero__visuals {
    height: 420px;
  }
}

/* ==========================================================================
   SEKCJA SKLEP & GALERIA
   ========================================================================== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 3.5rem;
  gap: 2rem;
  flex-wrap: wrap;
}

.section-title {
  font-size: clamp(2rem, 3.5vw, 3rem);
  letter-spacing: -0.01em;
}

.filter-bar {
  display: flex;
  gap: 0.5rem;
  background-color: var(--bg-card);
  padding: 0.35rem;
  border-radius: 50px;
  border: 1px solid var(--border-color);
}

.filter-btn {
  padding: 0.6rem 1.25rem;
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: all 0.3s;
}

.filter-btn:hover {
  color: var(--text-main);
}

.filter-btn.is-active {
  background-color: var(--text-main);
  color: var(--bg-color);
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 2.5rem;
}

@media (max-width: 576px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}

/* Karta produktu z efektem 3D Tilt */
.product-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border-color);
  transition: transform 0.4s var(--transition-smooth), box-shadow 0.4s var(--transition-smooth);
  display: flex;
  flex-direction: column;
  position: relative;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(154, 123, 86, 0.3);
}

.product-card__image-wrap {
  position: relative;
  height: 380px;
  overflow: hidden;
  background-color: var(--bg-card-hover);
  cursor: pointer;
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.5s ease, transform 0.7s var(--transition-smooth);
}

.product-card__image--detail {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.product-card:hover .product-card__image--main {
  opacity: 0;
}

.product-card:hover .product-card__image--detail {
  opacity: 1;
  transform: scale(1.05);
}

.product-card__badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background-color: rgba(250, 248, 245, 0.9);
  backdrop-filter: blur(4px);
  padding: 0.35rem 0.8rem;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 50px;
  letter-spacing: 0.05em;
  z-index: 2;
  color: var(--accent);
}

.product-card__quick-view {
  position: absolute;
  bottom: 16px;
  right: 16px;
  background-color: var(--text-main);
  color: var(--bg-color);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  opacity: 0;
  transform: translateY(10px);
  transition: all 0.3s var(--transition-smooth);
}

.product-card:hover .product-card__quick-view {
  opacity: 1;
  transform: translateY(0);
}

.product-card__content {
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: space-between;
}

.product-card__category {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

.product-card__title {
  font-size: 1.35rem;
  margin-bottom: 0.35rem;
  color: var(--text-main);
}

.product-card__subtitle {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.product-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1.25rem;
  border-top: 1px solid var(--border-color);
}

.product-card__price {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 600;
}

.product-card__btn {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 0.35rem;
  transition: color 0.3s;
}

.product-card__btn:hover {
  color: var(--accent);
}

/* ==========================================================================
   SEKCJA PROCES I PAPIERY
   ========================================================================== */
.craft {
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
}

.craft__layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 5rem;
  align-items: center;
}

.craft__intro .section-title {
  margin-bottom: 1.5rem;
}

.craft__lead {
  font-size: 1.125rem;
  color: var(--text-muted);
  margin-bottom: 2.5rem;
}

.craft__image-wrap {
  height: 380px;
}

.craft__pillars {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

@media (max-width: 992px) {
  .craft__layout {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}

@media (max-width: 576px) {
  .craft__pillars {
    grid-template-columns: 1fr;
  }
}

.pillar-card {
  background-color: var(--bg-color);
  padding: 2.25rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pillar-card__number {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--accent);
  margin-bottom: 1rem;
  display: block;
}

.pillar-card__title {
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
}

.pillar-card__text {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.pillar-card__tag {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-main);
  padding-top: 1rem;
  border-top: 1px dashed var(--border-color);
}

/* ==========================================================================
   SEKCJA ZAMÓWIENIA INDYWIDUALNE
   ========================================================================== */
.custom-order__box {
  background-color: var(--text-main);
  color: var(--bg-color);
  border-radius: var(--radius-lg);
  padding: 5rem;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 4rem;
  align-items: center;
}

.custom-order__box .section-title {
  color: #fff;
  margin-bottom: 1.5rem;
}

.custom-order__desc {
  color: #C5C2BC;
  margin-bottom: 2rem;
  font-size: 1.05rem;
}

.custom-order__perks {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.custom-order__perks li {
  position: relative;
  padding-left: 1.5rem;
  font-size: 0.925rem;
  color: #DDD9D2;
}

.custom-order__perks li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  width: 6px;
  height: 6px;
  background-color: var(--accent);
  border-radius: 50%;
}

.custom-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

@media (max-width: 768px) {
  .form-row {
    grid-template-columns: 1fr;
  }
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #C5C2BC;
}

.form-group input,
.form-group select,
.form-group textarea {
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-sm);
  padding: 0.9rem 1rem;
  color: #fff;
  transition: border-color 0.3s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
}

.form-group select option {
  background-color: var(--text-main);
  color: #fff;
}

.custom-form__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1rem;
  flex-wrap: wrap;
}

.form-feedback {
  font-size: 0.875rem;
  color: #A3D9A5;
}

@media (max-width: 992px) {
  .custom-order__box {
    grid-template-columns: 1fr;
    padding: 3rem 2rem;
  }
}

/* ==========================================================================
   STOPKA
   ========================================================================== */
.footer {
  background-color: var(--text-main);
  color: var(--bg-color);
  padding: 6rem 0 3rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer__grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 4rem;
  margin-bottom: 5rem;
}

.footer__brand .brand__title {
  color: #fff;
  font-size: 1.5rem;
  margin-bottom: 1rem;
  display: block;
}

.footer__about {
  color: #A8A49E;
  max-width: 360px;
  font-size: 0.95rem;
}

.footer__col h4 {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent);
  margin-bottom: 1.5rem;
}

.footer__col ul {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.footer__col a {
  color: #C5C2BC;
  font-size: 0.925rem;
  transition: color 0.3s;
}

.footer__col a:hover {
  color: #fff;
}

.footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.8125rem;
  color: #8C8882;
  flex-wrap: wrap;
  gap: 1rem;
}

@media (max-width: 768px) {
  .footer__grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
}

/* ==========================================================================
   MODAL SZYBKIEGO PODGLÁDU (QUICK VIEW)
   ========================================================================== */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(28, 27, 26, 0.7);
  backdrop-filter: blur(8px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s var(--transition-smooth), visibility 0.4s;
  padding: 2rem;
}

.modal-backdrop.is-open {
  opacity: 1;
  visibility: visible;
}

.modal-dialog {
  background-color: var(--bg-color);
  width: 100%;
  max-width: 1050px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
  transform: scale(0.95);
  transition: transform 0.4s var(--transition-smooth);
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}

.modal-backdrop.is-open .modal-dialog {
  transform: scale(1);
}

.modal-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  z-index: 10;
  transition: background-color 0.3s;
}

.modal-close:hover {
  background-color: var(--accent);
  color: #fff;
}

.qv-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  overflow-y: auto;
}

.qv-gallery {
  padding: 2.5rem;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.qv-image-stage {
  position: relative;
  height: 420px;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: #fff;
}

.qv-image-stage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.qv-zoom-hint {
  position: absolute;
  bottom: 12px;
  left: 12px;
  background-color: rgba(28, 27, 26, 0.85);
  color: #fff;
  padding: 0.35rem 0.75rem;
  font-size: 0.7rem;
  border-radius: var(--radius-sm);
  pointer-events: none;
}

.qv-thumbs {
  display: flex;
  gap: 1rem;
}

.qv-thumb {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 2px solid transparent;
  transition: border-color 0.3s;
}

.qv-thumb.is-active {
  border-color: var(--accent);
}

.qv-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.qv-details {
  padding: 3rem;
  display: flex;
  flex-direction: column;
}

.qv-title {
  font-size: 2rem;
  margin-bottom: 0.35rem;
}

.qv-subtitle {
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.qv-price-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-color);
}

.qv-price {
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 600;
  color: var(--accent);
}

.qv-unit-info {
  font-size: 0.875rem;
  color: var(--text-muted);
}

.qv-description {
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.qv-specs {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 2rem;
  font-size: 0.875rem;
}

.qv-specs li {
  position: relative;
  padding-left: 1.25rem;
}

.qv-specs li::before {
  content: '\2713';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: 700;
}

.qv-config {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  margin-top: auto;
}

.qv-option-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.qv-option-group label {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
  color: var(--text-main);
}

.qv-select {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0.8rem 1rem;
  font-size: 0.925rem;
  outline: none;
  transition: border-color 0.3s;
}

.qv-select:focus {
  border-color: var(--accent);
}

.qv-purchase-row {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
}

.qty-control {
  display: flex;
  align-items: center;
  border: 1px solid var(--border-color);
  border-radius: 50px;
  background-color: var(--bg-card);
  overflow: hidden;
}

.qty-control button {
  width: 40px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.125rem;
  transition: background-color 0.2s;
}

.qty-control button:hover {
  background-color: var(--border-color);
}

.qty-control input {
  width: 48px;
  text-align: center;
  font-weight: 600;
  font-size: 0.95rem;
}

.qv-add-btn {
  flex-grow: 1;
}

.qv-min-note {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-style: italic;
  text-align: center;
}

@media (max-width: 992px) {
  .qv-grid {
    grid-template-columns: 1fr;
  }
  .modal-dialog {
    max-height: 95vh;
  }
}

/* ==========================================================================
   BOCZNA SZUFLADA KOSZYKA (SLIDE-OVER CART DRAWER)
   ========================================================================== */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(28, 27, 26, 0.6);
  backdrop-filter: blur(6px);
  z-index: 2500;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s;
}

.drawer-backdrop.is-open {
  opacity: 1;
  visibility: visible;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 480px;
  height: 100vh;
  background-color: var(--bg-color);
  z-index: 2600;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.5s var(--transition-smooth);
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.15);
}

.cart-drawer.is-open {
  transform: translateX(0);
}

.cart-drawer__header {
  padding: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color);
}

.cart-drawer__title {
  font-size: 1.5rem;
}

.cart-drawer__sub {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.shipping-progress {
  padding: 1.25rem 2rem;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.shipping-progress__text {
  font-size: 0.8125rem;
  margin-bottom: 0.6rem;
  color: var(--text-muted);
}

.shipping-progress__text strong {
  color: var(--text-main);
}

.shipping-progress__bar {
  width: 100%;
  height: 6px;
  background-color: var(--border-color);
  border-radius: 10px;
  overflow: hidden;
}

.shipping-progress__fill {
  display: block;
  height: 100%;
  background-color: var(--accent);
  transition: width 0.4s var(--transition-smooth);
}

.cart-drawer__body {
  flex-grow: 1;
  overflow-y: auto;
  padding: 1.5rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.cart-empty-state {
  text-align: center;
  margin: auto 0;
  color: var(--text-muted);
}

.cart-empty-state p {
  font-size: 1rem;
  margin-bottom: 1.5rem;
}

.cart-item {
  display: grid;
  grid-template-columns: 80px 1fr auto;
  gap: 1rem;
  align-items: center;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--border-color);
}

.cart-item__img {
  width: 80px;
  height: 80px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  background-color: var(--bg-card);
}

.cart-item__info h5 {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  margin-bottom: 0.15rem;
}

.cart-item__meta {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

.cart-item__price {
  font-weight: 600;
  font-size: 0.925rem;
}

.cart-item__controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.cart-item__qty-btn {
  width: 24px;
  height: 24px;
  border: 1px solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  transition: background-color 0.2s;
}

.cart-item__qty-btn:hover {
  background-color: var(--border-color);
}

.cart-item__remove {
  color: var(--text-light);
  font-size: 1.25rem;
  padding: 0.5rem;
  transition: color 0.2s;
}

.cart-item__remove:hover {
  color: var(--terracotta);
}

.cart-drawer__footer {
  padding: 2rem;
  background-color: var(--bg-card);
  border-top: 1px solid var(--border-color);
}

.cart-summary {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  font-size: 0.925rem;
}

.cart-summary__row {
  display: flex;
  justify-content: space-between;
  color: var(--text-muted);
}

.cart-summary__row--total {
  font-size: 1.25rem;
  font-family: var(--font-serif);
  font-weight: 600;
  color: var(--text-main);
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-color);
}

.btn--full {
  width: 100%;
}

.cart-drawer__secure {
  text-align: center;
  font-size: 0.725rem;
  color: var(--text-muted);
  margin-top: 1rem;
}

/* ==========================================================================
   POWIADOMIENIE TOAST
   ========================================================================== */
.toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background-color: var(--text-main);
  color: var(--bg-color);
  padding: 1rem 2rem;
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  z-index: 3000;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  opacity: 0;
  transition: transform 0.4s var(--transition-smooth), opacity 0.4s;
  pointer-events: none;
}

.toast.is-visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}